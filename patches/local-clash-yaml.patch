+// ============================================================
+// [本地补丁] 本地 Clash YAML 生成器 —— 零第三方订阅转换依赖
+// 将本地生成的 vless/trojan 链接直接转为 Clash Meta YAML，
+// 替代向 config_JSON.订阅转换配置.SUBAPI 发起的外部转换请求。
+// 同步上游后需重放本补丁（共 3 处，搜索 "[本地补丁]"）。
+// ============================================================
+function 本地生成ClashYAML(链接列表文本, config_JSON = {}) {
+	const 转义 = (值) => String(值 ?? '').replace(/\\/g, '\\\\').replace(/"/g, '\\"');
+	const 安全解码 = (文本) => { try { return decodeURIComponent(文本); } catch { return 文本; } };
+	const 解析链接 = (行) => {
+		const m = /^(vless|trojan):\/\/([^@/?#]+)@(\[[0-9a-fA-F:]+\]|[^:/?#]+):(\d+)(?:\?([^#]*))?(?:#(.*))?$/.exec(行.trim());
+		if (!m) return null;
+		const [, 类型, 凭据, 服务器, 端口, 查询 = '', 备注 = ''] = m;
+		const 参数 = new URLSearchParams(查询);
+		const 传输 = (参数.get('type') || 'tcp').toLowerCase();
+		const tls开启 = (参数.get('security') || '').toLowerCase() === 'tls';
+		const 节点 = {
+			name: 安全解码(备注) || `${服务器}:${端口}`,
+			type: 类型,
+			server: 服务器.replace(/^\[|\]$/g, ''),
+			port: Number(端口),
+			tls: tls开启,
+			network: 传输,
+		};
+		if (类型 === 'vless') 节点.uuid = 凭据; else 节点.password = 凭据;
+		if (tls开启) {
+			const sni = 参数.get('sni') || 参数.get('host') || '';
+			if (sni) 节点.servername = sni;
+			const fp = 参数.get('fp');
+			if (fp) 节点['client-fingerprint'] = fp;
+			const alpn = 参数.get('alpn');
+			if (alpn) 节点.alpn = alpn.split(',').map(a => a.trim()).filter(Boolean);
+		}
+		if (传输 === 'ws') {
+			节点.wsPath = 参数.get('path') || '/';
+			节点.wsHost = 参数.get('host') || 节点.servername || 服务器;
+		}
+		return 节点;
+	};
+
+	const 节点列表 = 链接列表文本.split(/\n+/).map(解析链接).filter(Boolean);
+	if (节点列表.length === 0) return 链接列表文本; // 无 vless/trojan 链接（如纯 ss 配置）时原样返回，行为回退为旧逻辑
+	const 已用名称 = new Set();
+	for (const p of 节点列表) {
+		let n = p.name, i = 2;
+		while (已用名称.has(n)) n = `${p.name} (${i++})`;
+		已用名称.add(n); p.name = n;
+	}
+
+	const 行 = [];
+	行.push('# 由 edgetunnel [本地补丁] 生成，未经过任何第三方订阅转换服务');
+	行.push('proxies:');
+	for (const p of 节点列表) {
+		行.push(`  - name: "${转义(p.name)}"`);
+		行.push(`    type: ${p.type}`);
+		行.push(`    server: ${p.server}`);
+		行.push(`    port: ${p.port}`);
+		if (p.uuid) 行.push(`    uuid: ${p.uuid}`);
+		if (p.password !== undefined) 行.push(`    password: "${转义(p.password)}"`);
+		if (p.tls) 行.push('    tls: true');
+		if (p.servername) 行.push(`    servername: "${转义(p.servername)}"`);
+		if (p['client-fingerprint']) 行.push(`    client-fingerprint: ${转义(p['client-fingerprint'])}`);
+		if (p.alpn && p.alpn.length) 行.push(`    alpn: [${p.alpn.map(a => `"${转义(a)}"`).join(', ')}]`);
+		行.push('    udp: true');
+		if (p.network && p.network !== 'tcp') {
+			行.push(`    network: ${p.network}`);
+			if (p.network === 'ws') {
+				行.push('    ws-opts:');
+				行.push(`      path: "${转义(p.wsPath)}"`);
+				行.push('      headers:');
+				行.push(`        Host: "${转义(p.wsHost)}"`);
+			}
+		}
+	}
+	const 名称数组 = 节点列表.map(p => `"${转义(p.name)}"`);
+	行.push('proxy-groups:');
+	行.push('  - name: "节点选择"');
+	行.push('    type: select');
+	行.push(`    proxies: ["自动选择", "DIRECT", ${名称数组.join(', ')}]`);
+	行.push('  - name: "自动选择"');
+	行.push('    type: url-test');
+	行.push('    url: https://www.gstatic.com/generate_204');
+	行.push('    interval: 300');
+	行.push('    tolerance: 50');
+	行.push(`    proxies: [${名称数组.join(', ')}]`);
+	行.push('rules:');
+	行.push('  - GEOIP,LAN,DIRECT,no-resolve');
+	行.push('  - GEOIP,CN,DIRECT');
+	行.push('  - MATCH,节点选择');
+	return 行.join('\n') + '\n';
+}
+
 function Clash订阅配置文件热补丁(Clash_原始订阅内容, config_JSON = {}) {
 	const uuid = config_JSON?.UUID || null;
